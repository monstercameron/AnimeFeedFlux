# AnimeFeedFlux environment (PLAN.md §16).
#
# Install as /etc/animefeedflux/animefeedflux.env, mode 0600, owned by root.
# compose reads it via env_file. It is NEVER baked into the image: an image
# layer is readable by anyone who can pull it (RULE-2).
#
#   sudo install -D -m 0600 /dev/null /etc/animefeedflux/animefeedflux.env
#   sudo -e /etc/animefeedflux/animefeedflux.env
#
# This example file carries NO real values and is safe to commit. Every secret
# below is a placeholder that the pre-commit credential guard recognises as
# obviously fake.

# --- required ------------------------------------------------------------

# Absolute base for links, guids and atom:link rel=self. Baked into every guid,
# and a guid is forever — changing this later orphans every item ever published.
AFF_PUBLIC_BASE_URL=https://anime.earlcameron.com

# Inside the container. compose maps these to 127.0.0.1 on the host; publishing
# to 0.0.0.0 on the HOST side would expose them past ufw (§19).
AFF_PUBLISH_ADDR=0.0.0.0:9310
AFF_ADMIN_ADDR=0.0.0.0:9311

AFF_DB_PATH=/var/lib/animefeedflux/animefeedflux.db

# Comma-separated. Must be scheme://host, because that is exactly what a browser
# sends in the Origin header — a bare hostname matches nothing and every
# WebSocket upgrade is rejected with no clue why (§4).
AFF_ALLOWED_ORIGINS=https://admin.anime.earlcameron.com

# Derives the key that encrypts the TOTP secret at rest, so a stolen database
# file alone is not a second factor (§4). Generate with:
#   openssl rand -base64 48
AFF_SECRET_KEY=changeme-generate-a-real-one

# Read by SchemaFlux, NOT named OPENAI_API_KEY (§8, §16).
SCHEMAFLUX_API_KEY=changeme-your-key-here

# --- optional ------------------------------------------------------------

AFF_LOG_LEVEL=info
AFF_GENERATION_ENABLED=1

# §14.3. Defaults are correct for the 1-10 feed target; raising them without a
# measured reason just spends more of a 2 GB box.
#AFF_MAX_CONCURRENT_RUNS=3
#AFF_PROVIDER_MAX_INFLIGHT=4
#AFF_SCHEDULE_JITTER=10m
#AFF_CACHE_MAX_BYTES=67108864

AFF_BACKUP_DIR=/var/lib/animefeedflux/backups

# Off-box copy of the nightly backup (§15, TODOS.md C4-03). If set, the
# nightly job AES-256-GCM encrypts the freshly-verified local backup with
# AFF_BACKUP_ENCRYPTION_KEY below and writes it here; if unset, it alerts
# every night that no off-box copy exists rather than merely staying quiet
# about it.
#
# KNOWN GAP AS OF THIS WRITING (TODOS.md C4-03): this directory must be
# genuinely separate infrastructure from AFF_BACKUP_DIR above — a mounted
# network share or a second volume — or "off the box" is a lie and a single
# volume-loss event still takes the DB, the local backups, AND this copy at
# once (the exact ArticleFlux incident PLAN.md §15 cites). Nothing in
# deploy/compose.yaml currently mounts a second volume for this, and no
# upload/rsync/scp step exists anywhere in the codebase — setting this to a
# path on the SAME `animefeedflux-data` volume (e.g. a subdirectory of
# AFF_BACKUP_DIR) satisfies the code but not the actual goal. Point it at
# real separate infrastructure, or leave it unset and treat the nightly
# alert as the honest status it is.
#AFF_OFFSITE_DIR=

# The ONLY source for the off-box backup encryption key (internal/ops/cli.go
# EncryptionKeyEnv) — required if AFF_OFFSITE_DIR is set, ignored otherwise.
# Read directly from the process environment (not through internal/config's
# validator), but env_file still supplies it since compose populates the
# whole process environment from this file either way.
#
# Same warning as AFF_PASSWORD_PEPPER below: back this up SEPARATELY from
# both the database and the encrypted backups it protects — a copy stored
# next to what it encrypts is not a backup of the key, it is a backup of a
# locked box next to its own key.
# Generate with:
#   openssl rand -base64 32
#AFF_BACKUP_ENCRYPTION_KEY=

# Staleness and failure alerts. A generator that silently stops is worse than
# one that crashes (§15), so this is the one integration worth configuring early.
#AFF_SLACK_WEBHOOK_URL=

# Directory the compiled GWC/WASM admin bundle is served from (§12, §15.1).
# The Dockerfile now builds and stages it at /web/dist at image build time,
# which is also where the binary's own default (config.DefaultAdminStaticDir,
# a *relative* "web/dist" resolved against the image's unset WORKDIR "/")
# already resolves to — so this line is redundant with compose.yaml's own
# explicit AFF_ADMIN_STATIC_DIR and neither needs to be set here. Left
# commented out as documentation for anyone running the binary outside that
# compose file (bare-metal, a different image layout, local dev against
# `web/build.sh`'s default web/dist).
#AFF_ADMIN_STATIC_DIR=/web/dist

# --- password pepper (§4, §16) --------------------------------------------
#
# OPTIONAL, and the one variable on this page that deserves its own warning:
# if this is set, every stored password hash is HMAC-SHA256(pepper, ...) and
# NOTHING VERIFIES WITHOUT IT. Lose this value with no other copy and the
# single admin account is locked out permanently — there is no recovery path
# that does not involve this exact string, because the whole point of a
# pepper is that it lives nowhere the database does.
#
# THEREFORE: back this up SEPARATELY from the database backup (§15's nightly
# VACUUM INTO snapshot, shipped off-box encrypted). Bundling it into the same
# backup archive as the DB defeats the entire reason it exists — an attacker
# (or a lost backup) who gets one gets both. A password manager entry, a
# separate encrypted file, a physical printout in a safe: anything that is
# not "next to the database copy."
#
# Generate with:
#   openssl rand -base64 32
#AFF_PASSWORD_PEPPER=
#
# Required (and validated at boot, config.go's pepperVersion) whenever a
# pepper is set — rejected as malformed if it is present with no pepper, or
# missing/non-positive with one. Bump this on every pepper rotation; it
# travels with the hash so a rotation can be recognised and re-verified
# rather than locking out every credential hashed under the old value.
#AFF_PASSWORD_PEPPER_VERSION=1

# --- observability (§15.0a) ----------------------------------------------
#
# Off by default. Instrumentation always runs; only the exporter is gated. A
# collector on this box would spend more watching the system than running it,
# so when enabled this goes straight to a hosted backend with no local collector.
AFF_OTEL_ENABLED=0
#AFF_OTEL_EXPORTER=otlp
#AFF_TRACE_SAMPLE_RATIO=0.05
#OTEL_SERVICE_NAME=animefeedflux
#OTEL_EXPORTER_OTLP_ENDPOINT=
# Carries the backend's auth token — treat as a secret.
#OTEL_EXPORTER_OTLP_HEADERS=
